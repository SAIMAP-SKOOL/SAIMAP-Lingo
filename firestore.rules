rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona solo puede leer, escribir y borrar su propio progreso:
    //   users/<uid>                 → italiano
    //   users/<uid>/courses/<idioma> → resto de idiomas
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      match /courses/{course} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && course.matches("^[a-z]{2,3}$");
      }
      //   users/<uid>/psicologia/<doc> → SAIMAP Psicología (_global y una por asignatura)
      match /psicologia/{doc} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && doc.matches("^[a-z0-9_-]{1,40}$");
      }
    }
  }
}
